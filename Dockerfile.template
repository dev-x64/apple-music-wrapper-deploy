FROM debian:13.2
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY upstream/wrapper-lite-rootless /app/wrapper-lite-rootless
COPY upstream/rootfs /app/rootfs
RUN chmod +x /app/wrapper-lite-rootless /app/rootfs/system/bin/lite
EXPOSE 12340
ENTRYPOINT ["/app/wrapper-lite-rootless"]
CMD ["--base-dir", "/data", "--host", "0.0.0.0", "--port", "12340"]
