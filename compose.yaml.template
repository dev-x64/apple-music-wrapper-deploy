services:
  wrapper:
    image: apple-music-wrapper:local
    container_name: wrapper
    build:
      context: .
      dockerfile: Dockerfile
    network_mode: host
    privileged: true
    volumes:
      - ./data:/app/rootfs/data
    command:
      - --base-dir
      - /data
      - --host
      - 0.0.0.0
      - --port
      - "${WRAPPER_PORT:-12340}"
    restart: unless-stopped
